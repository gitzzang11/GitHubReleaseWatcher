<Window x:Class="GitHubReleaseWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Title="GitHub Release Watcher"
        Icon="Assets/AppIcon.ico"
        Width="820" Height="720" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="36" Height="36" Source="Assets/AppIcon.png" Stretch="Uniform" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="GitHub Release Watcher" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="새 Release를 놓치지 않도록 조용히 확인합니다" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding ToggleSettingsCommand}" ToolTip="설정" AutomationProperties.Name="설정 열기" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="860" Margin="26,24,26,26">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="GitHub 저장소 URL" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="RepositoryUrlBox" Grid.Column="0" Text="{Binding RepositoryUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                             ToolTip="예: https://github.com/Flow-Launcher/Flow.Launcher" AutomationProperties.Name="GitHub 저장소 URL"
                             PreviewKeyDown="OnRepositoryUrlKeyDown" />
                    <Button Grid.Column="1" Content="추가" MinWidth="78" Style="{StaticResource AccentButton}" Command="{Binding AddRepositoryCommand}" IsDefault="True" />
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding InputError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,6,0,0" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="12,9" Margin="0,12,0,0" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BannerMessage}" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,26,0,0">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding UpdateSummary}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Repositories.Count, StringFormat={}{0}개 저장소}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="28" Margin="0,0,0,10">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Repositories.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="감시 중인 저장소가 없습니다" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="위에 GitHub 저장소 URL을 붙여넣으면 현재 Release를 기준으로 감시를 시작합니다." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Repositories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="18,16">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" MinWidth="0">
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}" />
                                            <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource RaisedBrush}" BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="14,0,0,0" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontWeight="Bold" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding VersionText}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                            <TextBlock Text="{Binding LastCheckedText, StringFormat=마지막 확인: {0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding DataContext.RefreshRepositoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="이 저장소 새로 고침" AutomationProperties.Name="저장소 새로 고침" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DataContext.DeleteRepositoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="저장소 삭제" AutomationProperties.Name="저장소 삭제" />
                                                <Button Content="Release 보기" MinHeight="32" Padding="12,4" Margin="6,0,0,0" Command="{Binding DataContext.OpenReleaseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="26,13">
            <Grid><TextBlock Text="{Binding LastFullCheckText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Content="{Binding CheckButtonText}" Command="{Binding CheckAllCommand}" MinWidth="96" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Background="#66000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" MouseLeftButtonDown="OnOverlayClick" />
        <Border Grid.Row="0" Grid.RowSpan="3" Width="390" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="26"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0"><TextBlock Text="설정" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding ToggleSettingsCommand}" ToolTip="닫기" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,16">
                    <StackPanel>
                        <TextBlock Text="일반" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                        <CheckBox Content="Windows 시작 시 자동 실행" IsChecked="{Binding RunAtStartup}" />
                        <CheckBox Content="창을 닫을 때 트레이로 최소화" IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,4,0,0" />
                        <TextBlock Text="업데이트 확인 간격" Margin="0,18,0,7" />
                        <ListBox ItemsSource="{Binding CheckIntervals}" SelectedItem="{Binding CheckIntervalMinutes}" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,6,6" /><Setter Property="Padding" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Choice" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11,7">
                                            <ContentPresenter HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderThickness" Value="2" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource IntervalLabel}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="알림" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10" />
                        <Button Content="테스트 알림 보내기" Command="{Binding TestNotificationCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="알림이 보이지 않으면 Windows 설정의 시스템 > 알림에서 허용 상태를 확인해 주세요." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
                        <Separator Margin="0,24" Background="{DynamicResource DividerBrush}" />
                        <TextBlock Text="GitHub" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                        <CheckBox Content="Pre-release 포함" IsChecked="{Binding IncludePrereleases}" />
                        <TextBlock Text="Personal Access Token (선택)" Margin="0,18,0,7" />
                        <PasswordBox x:Name="TokenBox" MinHeight="38" Padding="10,7" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" PasswordChanged="OnTokenChanged" ToolTip="Windows 자격 증명 관리자에 안전하게 저장됩니다" />
                        <TextBlock Text="공개 저장소는 Token 없이 사용할 수 있습니다. Token은 Windows 자격 증명 관리자에 저장됩니다." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Command="{Binding ToggleSettingsCommand}" Margin="0,0,8,0" /><Button Content="저장" Style="{StaticResource AccentButton}" Command="{Binding SaveSettingsCommand}" MinWidth="80" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
