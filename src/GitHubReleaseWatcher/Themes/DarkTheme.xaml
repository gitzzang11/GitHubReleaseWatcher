<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#161B22" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#21262D" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#21262D" />
    <SolidColorBrush x:Key="DividerBrush" Color="#30363D" />

    <!-- Typography -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F0F6FC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9198A1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#656C76" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#0D1117" />

    <!-- Controls & Inputs -->
    <SolidColorBrush x:Key="ControlBrush" Color="#21262D" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#30363D" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#282E33" />
    <SolidColorBrush x:Key="InputBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#58A6FF" />

    <!-- Brand / Accent (GitHub Dark Blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1F6FEB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#388BFD" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1158C7" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#102540" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#58A6FF" />

    <!-- Window Caption Buttons -->
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#30363D" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#3E444E" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CaptionCloseForegroundBrush" Color="#FFFFFF" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#484F58" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#6E7681" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />

    <!-- Status Tags / Badges -->
    <SolidColorBrush x:Key="StatusLatestBgBrush" Color="#122A1E" />
    <SolidColorBrush x:Key="StatusLatestFgBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="StatusLatestBorderBrush" Color="#238636" />

    <SolidColorBrush x:Key="StatusUpdateBgBrush" Color="#102540" />
    <SolidColorBrush x:Key="StatusUpdateFgBrush" Color="#58A6FF" />
    <SolidColorBrush x:Key="StatusUpdateBorderBrush" Color="#1F6FEB" />

    <SolidColorBrush x:Key="StatusCheckingBgBrush" Color="#2B2006" />
    <SolidColorBrush x:Key="StatusCheckingFgBrush" Color="#D29922" />
    <SolidColorBrush x:Key="StatusCheckingBorderBrush" Color="#9E6A03" />

    <SolidColorBrush x:Key="StatusFailedBgBrush" Color="#2C1517" />
    <SolidColorBrush x:Key="StatusFailedFgBrush" Color="#F85149" />
    <SolidColorBrush x:Key="StatusFailedBorderBrush" Color="#DA3633" />

    <SolidColorBrush x:Key="StatusNoReleasesBgBrush" Color="#161B22" />
    <SolidColorBrush x:Key="StatusNoReleasesFgBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="StatusNoReleasesBorderBrush" Color="#30363D" />

    <!-- General Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F85149" />
    <SolidColorBrush x:Key="InfoBrush" Color="#58A6FF" />
</ResourceDictionary>
