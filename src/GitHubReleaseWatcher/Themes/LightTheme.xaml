<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#40000000" />

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D7DE" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E1E4E8" />

    <!-- Typography -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#656D76" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8C959F" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />

    <!-- Controls & Inputs -->
    <SolidColorBrush x:Key="ControlBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EBEFF3" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#DFE4EA" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#0969DA" />

    <!-- Brand / Accent (GitHub Classic Blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0858BA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#07489A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF4FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0969DA" />

    <!-- Window Caption Buttons -->
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#DADADA" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CaptionCloseForegroundBrush" Color="#FFFFFF" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C7CBD1" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A2A8B2" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#818996" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />

    <!-- Status Tags / Badges -->
    <SolidColorBrush x:Key="StatusLatestBgBrush" Color="#DAFBE1" />
    <SolidColorBrush x:Key="StatusLatestFgBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="StatusLatestBorderBrush" Color="#B4E9C1" />

    <SolidColorBrush x:Key="StatusUpdateBgBrush" Color="#DDF4FF" />
    <SolidColorBrush x:Key="StatusUpdateFgBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="StatusUpdateBorderBrush" Color="#B6E3FF" />

    <SolidColorBrush x:Key="StatusCheckingBgBrush" Color="#FFF8C5" />
    <SolidColorBrush x:Key="StatusCheckingFgBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="StatusCheckingBorderBrush" Color="#F9E68B" />

    <SolidColorBrush x:Key="StatusFailedBgBrush" Color="#FFEBE9" />
    <SolidColorBrush x:Key="StatusFailedFgBrush" Color="#CF222E" />
    <SolidColorBrush x:Key="StatusFailedBorderBrush" Color="#FFC1BA" />

    <SolidColorBrush x:Key="StatusNoReleasesBgBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="StatusNoReleasesFgBrush" Color="#656D76" />
    <SolidColorBrush x:Key="StatusNoReleasesBorderBrush" Color="#D0D7DE" />

    <!-- General Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="DangerBrush" Color="#CF222E" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0969DA" />
</ResourceDictionary>
